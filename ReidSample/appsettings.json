{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=reid_sample.db"
  },
  "ReidFeature": {
    "BaseUrl": "http://localhost:9000"
  },
  "Matching": {
    "SimilarityThreshold": 0.6
  }
}
