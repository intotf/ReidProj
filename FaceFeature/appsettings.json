{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:9001"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Onnx": {
    "Face": {
      "IntraOpNumThreads": 1,
      "InterOpNumThreads": 1
    },
    "FaceRec": {
      "IntraOpNumThreads": 0
    }
  },
  "AllowedHosts": "*"
}
