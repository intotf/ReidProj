<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReIdFaceBox.Views.ExtractWindow"
        Title="提取目标数据"
        Width="600" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="14">

        <TextBlock Text="筛选条件" FontWeight="Bold" FontSize="14" />
        <TextBlock Text="尺寸为宽×高的最小像素值，设为 0 表示不限制" Foreground="Gray" FontSize="12" Margin="0,-8,0,0" />

        <!-- 人脸条件 -->
        <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="4" Padding="12,8">
            <StackPanel Spacing="8">
                <CheckBox x:Name="ChkFace" Content="人脸尺寸过滤 (face.bbox)" IsChecked="True" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="24,0,0,0">
                    <TextBlock Text="最小宽度:" VerticalAlignment="Center" />
                    <NumericUpDown x:Name="FaceMinWidth" Value="0" Minimum="0" Width="120" />
                    <TextBlock Text="最小高度:" VerticalAlignment="Center" Margin="20,0,0,0" />
                    <NumericUpDown x:Name="FaceMinHeight" Value="0" Minimum="0" Width="120" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 条件逻辑（仅当人脸和人型都勾选时显示） -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,0"
                    x:Name="PnlLogic" HorizontalAlignment="Center">
            <TextBlock Text="条件逻辑:" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbLogic" SelectedIndex="0" Width="100">
                <ComboBoxItem Content="And" />
                <ComboBoxItem Content="Or" />
            </ComboBox>
        </StackPanel>

        <!-- 人型条件 -->
        <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="4" Padding="12,8">
            <StackPanel Spacing="8">
                <CheckBox x:Name="ChkBody" Content="人型尺寸过滤 (bbox)" IsChecked="True" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="24,0,0,0">
                    <TextBlock Text="最小宽度:" VerticalAlignment="Center" />
                    <NumericUpDown x:Name="BodyMinWidth" Value="0" Minimum="0" Width="120" />
                    <TextBlock Text="最小高度:" VerticalAlignment="Center" Margin="20,0,0,0" />
                    <NumericUpDown x:Name="BodyMinHeight" Value="0" Minimum="0" Width="120" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 输出选项 -->
        <CheckBox x:Name="ChkCropBbox" Content="只提取特征区域（按 bbox 裁剪保存，否则保存完整原图）" IsChecked="False" />

        <!-- 保存路径 -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="保存目录:" VerticalAlignment="Center" />
            <TextBox x:Name="TxtOutputDir" Width="380" />
            <Button Content="浏览..." Click="OnBrowseDir" />
        </StackPanel>

        <!-- 操作按钮 -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Click="OnExtract" Width="90">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="📥" VerticalAlignment="Center" />
                    <TextBlock Text="提取" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="OnCancel" Width="90">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="✖" VerticalAlignment="Center" />
                    <TextBlock Text="关闭" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock x:Name="TxtStatus" Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>
</Window>
