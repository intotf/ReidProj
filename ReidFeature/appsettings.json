{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:9000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Onnx": {
    "Yolo": {
      "IntraOpNumThreads": 1,
      "InterOpNumThreads": 1,
      "ExecutionMode": "ORT_SEQUENTIAL",
      "GraphOptimizationLevel": "ORT_ENABLE_ALL"
    },
    "ReId": {
      "IntraOpNumThreads": 1,
      "InterOpNumThreads": 1
    },
    "Face": {
      "IntraOpNumThreads": 1,
      "InterOpNumThreads": 1
    }
  },
  "AllowedHosts": "*"
}
